opam-version: "2.0"
maintainer: "thery@sophia.inria.fr"
version: "dev"
homepage: "https://github.com/thery/minirubik"
dev-repo: "git+https://github.com/thery/minirubik.git"
bug-reports: "https://github.com/thery/minirubik/issues"
license: "MIT"
synopsis: "A certified shortest-path solver for the Rubik 3x3x3 cube"
description: """
A full 54-sticker model of the 3x3x3 Rubik's cube, with six fixed centers
and all 18 face turns. Rocq proofs establish geometric move correctness,
solver soundness, completeness for reachable states, and global minimality
in the face-turn metric. The finite exhaustive search is intended as a
certified reference solver; deep scrambles are computationally expensive.
"""
build: [make "-j%{jobs}%"]
run-test: [make "check"]
install: [make "install"]
depends: [
  "coq" {>= "9.0.0"}
  "conf-python-3" {with-test}
]
tags: ["keyword:rubik" "logpath:minirubik"]
authors: ["Laurent Théry"]
