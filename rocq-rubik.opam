opam-version: "2.0"
maintainer: "thery@sophia.inria.fr"
version: "dev"
homepage: "https://github.com/joom/rubik"
dev-repo: "git+https://github.com/joom/rubik.git"
bug-reports: "https://github.com/joom/rubik/issues"
license: "MIT"
synopsis: "A certified solver for the Rubik 3x3x3 cube"
description: """
A full 54-sticker model of the 3x3x3 Rubik's cube, with six fixed centers
and all 18 face turns. Rocq proofs establish geometric move correctness,
solver soundness, completeness for reachable states, and global minimality
in the face-turn metric. The exhaustive search is a certified reference
solver; deep scrambles are computationally expensive. A two-phase solver
after Kociemba, proved sound but not minimal, solves arbitrary scrambles in
seconds and is what the viewer calls.

The package covers the proofs only. The raylib viewer under native/ is built
separately and needs the Crane submodule.
"""
build: [
  ["dune" "build" "-p" name "-j" jobs "@install"]
]
run-test: [make "check"]
depends: [
  "dune" {>= "3.21"}
  "rocq-core" {>= "9.0"}
  "rocq-stdlib" {>= "9.0"}
  "coq-ext-lib"
  "conf-python-3" {with-test}
]
tags: ["keyword:rubik" "logpath:Rubik"]
authors: ["Laurent Théry" "Joomy Korkut"]
